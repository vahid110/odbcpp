      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "windows-pg",
      "configurePreset": "windows-pg",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1,
        "stopOnFailure": false,
        "noTestsAction": "error",
        "timeout": 1500
      }
    },
    {
      "name": "windows-pg-offline",
      "configurePreset": "windows-pg",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1,
        "stopOnFailure": false,
        "noTestsAction": "error",
        "timeout": 1500
      },
      "filter": {
        "exclude": {
          "label": "integration"
        }
      }
    },
