{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TARGET_DATABASE": "POSTGRESQL",
        "BUILD_TESTING": "ON",
        "BUILD_EXAMPLES": "OFF",
        "ODBCPP_CRYPTO_PROVIDER": "OPENSSL"
      }
    },
    {
      "name": "postgresql",
      "inherits": "_base",
      "displayName": "PostgreSQL (host defaults)"
    },
    {
      "name": "default",
      "inherits": "postgresql"
    },
    {
      "name": "redshift",
      "inherits": "_base",
      "cacheVariables": {
        "TARGET_DATABASE": "REDSHIFT"
      }
    },
    {
      "name": "minimal",
      "inherits": "redshift",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "windows-pg",
      "inherits": "_base",
      "generator": "Visual Studio 17 2022",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "TARGET_DATABASE": "POSTGRESQL",
        "ODBCPP_EXPECT_DRIVER_SQLWCHAR_SIZE": "2",
        "ODBCPP_EXPECT_DM_SQLWCHAR_SIZE": "2",
        "ODBC_DRIVER_MANAGER_FLAVOR": "AUTO",
        "ODBCPP_CRYPTO_LINKAGE": "BUNDLED_SHARED"
      },
      "architecture": "x64"
    },
    {
      "name": "windows-redshift",
      "inherits": "_base",
      "generator": "Visual Studio 17 2022",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "TARGET_DATABASE": "REDSHIFT",
        "ODBCPP_EXPECT_DRIVER_SQLWCHAR_SIZE": "2",
        "ODBCPP_EXPECT_DM_SQLWCHAR_SIZE": "2",
        "ODBC_DRIVER_MANAGER_FLAVOR": "AUTO",
        "ODBCPP_CRYPTO_LINKAGE": "BUNDLED_SHARED"
      },
      "architecture": "x64"
    },
    {
      "name": "unixodbc-pg",
      "inherits": "_base",
      "generator": "Ninja",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Darwin"
        ]
      },
      "cacheVariables": {
        "TARGET_DATABASE": "POSTGRESQL",
        "ODBCPP_EXPECT_DRIVER_SQLWCHAR_SIZE": "2",
        "ODBCPP_EXPECT_DM_SQLWCHAR_SIZE": "2",
        "ODBC_DRIVER_MANAGER_FLAVOR": "UNIXODBC",
        "ODBCPP_CRYPTO_LINKAGE": "SYSTEM_SHARED"
      }
    },
    {
      "name": "unixodbc-redshift",
      "inherits": "_base",
      "generator": "Ninja",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Darwin"
        ]
      },
      "cacheVariables": {
        "TARGET_DATABASE": "REDSHIFT",
        "ODBCPP_EXPECT_DRIVER_SQLWCHAR_SIZE": "2",
        "ODBCPP_EXPECT_DM_SQLWCHAR_SIZE": "2",
        "ODBC_DRIVER_MANAGER_FLAVOR": "UNIXODBC",
        "ODBCPP_CRYPTO_LINKAGE": "SYSTEM_SHARED"
      }
    },
    {
      "name": "linux-iodbc-pg",
      "inherits": "_base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "TARGET_DATABASE": "POSTGRESQL",
        "ODBCPP_EXPECT_DRIVER_SQLWCHAR_SIZE": "4",
        "ODBCPP_EXPECT_DM_SQLWCHAR_SIZE": "4",
        "ODBC_DRIVER_MANAGER_FLAVOR": "IODBC",
        "ODBCPP_CRYPTO_LINKAGE": "SYSTEM_SHARED",
        "ODBC_INCLUDE_DIR": "$penv{ODBCPP_IODBC_ROOT}/include",
        "ODBC_DRIVER_MANAGER_INCLUDE_DIR": "$penv{ODBCPP_IODBC_ROOT}/include",
        "ODBC_DRIVER_MANAGER_LIBRARY": "$penv{ODBCPP_IODBC_ROOT}/lib/libiodbc.so"
      }
    },
    {
      "name": "linux-iodbc-redshift",
      "inherits": "_base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "TARGET_DATABASE": "REDSHIFT",
        "ODBCPP_EXPECT_DRIVER_SQLWCHAR_SIZE": "4",
        "ODBCPP_EXPECT_DM_SQLWCHAR_SIZE": "4",
        "ODBC_DRIVER_MANAGER_FLAVOR": "IODBC",
        "ODBCPP_CRYPTO_LINKAGE": "SYSTEM_SHARED",
        "ODBC_INCLUDE_DIR": "$penv{ODBCPP_IODBC_ROOT}/include",
        "ODBC_DRIVER_MANAGER_INCLUDE_DIR": "$penv{ODBCPP_IODBC_ROOT}/include",
        "ODBC_DRIVER_MANAGER_LIBRARY": "$penv{ODBCPP_IODBC_ROOT}/lib/libiodbc.so"
      }
    },
    {
      "name": "macos-iodbc-pg",
      "inherits": "_base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "TARGET_DATABASE": "POSTGRESQL",
        "ODBCPP_EXPECT_DRIVER_SQLWCHAR_SIZE": "4",
        "ODBCPP_EXPECT_DM_SQLWCHAR_SIZE": "4",
        "ODBC_DRIVER_MANAGER_FLAVOR": "IODBC",
        "ODBCPP_CRYPTO_LINKAGE": "SYSTEM_SHARED",
        "ODBC_INCLUDE_DIR": "$penv{ODBCPP_IODBC_ROOT}/include",
        "ODBC_DRIVER_MANAGER_INCLUDE_DIR": "$penv{ODBCPP_IODBC_ROOT}/include",
        "ODBC_DRIVER_MANAGER_LIBRARY": "$penv{ODBCPP_IODBC_ROOT}/lib/libiodbc.dylib"
      }
    },
    {
      "name": "macos-iodbc-redshift",
      "inherits": "_base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "TARGET_DATABASE": "REDSHIFT",
        "ODBCPP_EXPECT_DRIVER_SQLWCHAR_SIZE": "4",
        "ODBCPP_EXPECT_DM_SQLWCHAR_SIZE": "4",
        "ODBC_DRIVER_MANAGER_FLAVOR": "IODBC",
        "ODBCPP_CRYPTO_LINKAGE": "SYSTEM_SHARED",
        "ODBC_INCLUDE_DIR": "$penv{ODBCPP_IODBC_ROOT}/include",
        "ODBC_DRIVER_MANAGER_INCLUDE_DIR": "$penv{ODBCPP_IODBC_ROOT}/include",
        "ODBC_DRIVER_MANAGER_LIBRARY": "$penv{ODBCPP_IODBC_ROOT}/lib/libiodbc.dylib"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "postgresql",
      "configurePreset": "postgresql",
      "configuration": "Release",
      "jobs": 2
