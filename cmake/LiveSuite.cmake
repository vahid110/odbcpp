include_guard(GLOBAL)
include(CMakeParseArguments)

# Register existing GoogleTest binaries; CTest owns their execution and results.
# See tests/development/live_suite/README.md for the public JSON interface.
function(_odbcpp_live_get output json)
  string(JSON value ERROR_VARIABLE error GET "${json}" ${ARGN})
  if(NOT error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "Invalid live-suite JSON field: ${ARGN}")
  endif()
  set("${output}" "${value}" PARENT_SCOPE)
endfunction()

function(odbcpp_add_live_suite)
  cmake_parse_arguments(PARSE_ARGV 0 live "" "INDEX;EXPECTED;OUTPUT_DIRECTORY" "")
  if(live_UNPARSED_ARGUMENTS OR NOT live_INDEX OR NOT live_EXPECTED OR NOT live_OUTPUT_DIRECTORY)
    message(FATAL_ERROR "odbcpp_add_live_suite requires INDEX, EXPECTED and OUTPUT_DIRECTORY")
  endif()
  foreach(path IN ITEMS "${live_INDEX}" "${live_EXPECTED}" "${live_OUTPUT_DIRECTORY}")
    if(NOT IS_ABSOLUTE "${path}")
      message(FATAL_ERROR "Live-suite input/output paths must be absolute")
    endif()
  endforeach()
  # CMake generates the ENVIRONMENT property into CTestTestfile.cmake. Keep
  # that metadata private even when profile values contain connection strings.
  if(UNIX)
    execute_process(COMMAND /bin/sh -c umask OUTPUT_VARIABLE mask OUTPUT_STRIP_TRAILING_WHITESPACE
      COMMAND_ERROR_IS_FATAL ANY)
    if(NOT mask MATCHES "^0*77$")
      message(FATAL_ERROR "Configure the live suite with umask 077; generated CTest metadata is private")
    endif()
  endif()
  file(CHMOD "${CMAKE_BINARY_DIR}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
  if(EXISTS "${CMAKE_BINARY_DIR}/CTestTestfile.cmake")
    file(CHMOD "${CMAKE_BINARY_DIR}/CTestTestfile.cmake" PERMISSIONS OWNER_READ OWNER_WRITE)
  endif()
  file(READ "${live_INDEX}" index)
  file(READ "${live_EXPECTED}" expected)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${live_INDEX}" "${live_EXPECTED}")
  foreach(document IN ITEMS index expected)
    _odbcpp_live_get(version "${${document}}" schema_version)
    if(NOT version STREQUAL "1")
      message(FATAL_ERROR "Unsupported live-suite schema_version")
    endif()
  endforeach()
  string(JSON count ERROR_VARIABLE error LENGTH "${index}" cases)
  string(JSON expected_count ERROR_VARIABLE expected_error LENGTH "${expected}" cases)
  if(NOT error STREQUAL "NOTFOUND" OR NOT expected_error STREQUAL "NOTFOUND"
      OR count LESS 1 OR NOT count EQUAL expected_count)
    message(FATAL_ERROR "Live-suite inventory count mismatch or empty inventory")
  endif()
  file(MAKE_DIRECTORY "${live_OUTPUT_DIRECTORY}")
  file(CHMOD "${live_OUTPUT_DIRECTORY}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
  set(seen)
  set(checked_images)
  math(EXPR last "${count} - 1")
  foreach(number RANGE 0 ${last})
    foreach(field IN ITEMS id image profile gtest_filter)
      _odbcpp_live_get("${field}" "${index}" cases ${number} ${field})
      _odbcpp_live_get(wanted "${expected}" cases ${number} ${field})
      if(NOT "${${field}}" STREQUAL "${wanted}")
        message(FATAL_ERROR "Live-suite ordered inventory mismatch at case ${number}, ${field}")
      endif()
      if(NOT "${${field}}" MATCHES "^[A-Za-z0-9_./:@+-]+$")
        message(FATAL_ERROR "Unsupported live-suite identity at case ${number}, ${field}")
      endif()
    endforeach()
    # A filter selects exactly one accepted case, never a wildcard/negative list.
    if(NOT gtest_filter MATCHES "^[A-Za-z0-9_/]+\\.[A-Za-z0-9_/]+$")
      message(FATAL_ERROR "Live-suite gtest_filter must be one exact case")
    endif()
    set(identity "${image}@@${profile}@@${gtest_filter}")
    if(id IN_LIST seen OR identity IN_LIST seen)
      message(FATAL_ERROR "Duplicate live-suite case/profile identity")
    endif()
    list(APPEND seen "${id}" "${identity}")
    _odbcpp_live_get(executable "${index}" images "${image}" executable)
    _odbcpp_live_get(sha256 "${index}" images "${image}" sha256)
    if(NOT IS_ABSOLUTE "${executable}" OR NOT EXISTS "${executable}" OR IS_DIRECTORY "${executable}")
      message(FATAL_ERROR "Live-suite requires an existing absolute binary path")
    endif()
    string(LENGTH "${sha256}" hash_length)
    if(NOT hash_length EQUAL 64 OR NOT sha256 MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "Live-suite binary requires a SHA256 pin")
    endif()
    if(NOT image IN_LIST checked_images)
      file(SHA256 "${executable}" actual_sha256)
      if(NOT actual_sha256 STREQUAL sha256)
        message(FATAL_ERROR "Live-suite binary SHA256 mismatch")
      endif()
      list(APPEND checked_images "${image}")
    endif()
    _odbcpp_live_get(timeout "${index}" cases ${number} timeout_seconds)
    if(NOT timeout MATCHES "^[1-9][0-9]*$")
      message(FATAL_ERROR "Live-suite requires a positive integer per-case timeout")
    endif()
    string(JSON profile_json ERROR_VARIABLE error GET "${index}" profiles "${profile}")
    if(NOT error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "Live-suite case references an unknown profile")
    endif()
    string(JSON environment_file ERROR_VARIABLE file_error GET "${profile_json}" environment_file)
    string(JSON public_environment ERROR_VARIABLE public_error GET "${profile_json}" environment)
    if(file_error STREQUAL "NOTFOUND")
      if(public_error STREQUAL "NOTFOUND" OR NOT IS_ABSOLUTE "${environment_file}")
        message(FATAL_ERROR "A private environment_file must be absolute and cannot combine with public environment")
      endif()
      file(READ "${environment_file}" profile_json)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${environment_file}")
    endif()
    string(JSON environment_count ERROR_VARIABLE error LENGTH "${profile_json}" environment)
    if(NOT error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "Live-suite profile requires an environment array or private environment_file")
    endif()
    set(environment)
    set(variable_names)
    if(environment_count GREATER 0)
      math(EXPR environment_last "${environment_count} - 1")
      foreach(entry RANGE 0 ${environment_last})
        _odbcpp_live_get(variable "${profile_json}" environment ${entry})
        if(NOT variable MATCHES "^([A-Za-z_][A-Za-z0-9_]*)=" OR variable MATCHES "[\n\r]" OR variable MATCHES "\\$<")
          message(FATAL_ERROR "Live-suite environment must contain literal NAME=value entries without newlines/generator expressions")
        endif()
        string(REGEX REPLACE "=.*$" "" variable_name "${variable}")
        if(variable_name IN_LIST variable_names)
          message(FATAL_ERROR "Duplicate live-suite environment variable")
        endif()
        list(APPEND variable_names "${variable_name}")
        # ODBC connection strings contain semicolons. Escape list delimiters,
        # preserving the exact environment value received by the binary.
        string(REPLACE ";" "\\;" variable "${variable}")
        list(APPEND environment "${variable}")
      endforeach()
    endif()
    math(EXPR ordinal "${number} + 1")
    set(name "live.${ordinal}.${id}")
    add_test(NAME "${name}" COMMAND "${executable}"
      "--gtest_filter=${gtest_filter}"
      "--gtest_output=xml:${live_OUTPUT_DIRECTORY}/case-${ordinal}.xml"
      "--gtest_color=no" "--gtest_also_run_disabled_tests")
    set_tests_properties("${name}" PROPERTIES
      TIMEOUT "${timeout}" RUN_SERIAL TRUE RESOURCE_LOCK odbcpp_live_database
      ENVIRONMENT "${environment}" LABELS "odbcpp-live;${image};${profile}"
      FAIL_REGULAR_EXPRESSION "Running 0 tests from 0 test suites")
  endforeach()
  message(STATUS "Registered complete live-suite inventory: ${count} case/profile tests")
endfunction()
