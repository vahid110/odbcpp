if(NOT WIN32)
  message(FATAL_ERROR "This configuration regression requires native Windows")
endif()
foreach(_required SOURCE_DIR BINARY_DIR LINKER GENERATOR)
  if(NOT DEFINED ${_required} OR NOT ${_required})
    message(FATAL_ERROR "${_required} is required")
  endif()
endforeach()
if(NOT EXISTS "${LINKER}")
  message(FATAL_ERROR "The selected product linker is unavailable")
endif()
file(TO_CMAKE_PATH "${LINKER}" _linker)
file(TO_CMAKE_PATH "${SOURCE_DIR}" _source)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_root "${BINARY_DIR}/crypto-inspector-no-tests-${_nonce}")
file(MAKE_DIRECTORY "${_root}/source")
# Exercise the real generator with no test module or compiler work. The mock
# OpenSSL values describe configuration only, never runtime qualification.
set(_project [=[
cmake_minimum_required(VERSION 3.20)
project(minimal_crypto_inspector NONE)
set(BUILD_TESTING OFF CACHE BOOL "No product tests" FORCE)
set(CMAKE_LINKER "@_linker@")
set(ODBCPP_CRYPTO_PROVIDER OPENSSL)
set(ODBCPP_CRYPTO_LINKAGE BUNDLED_SHARED)
set(ODBCPP_CRYPTO_ROOT_CANONICAL "${CMAKE_CURRENT_SOURCE_DIR}")
set(OPENSSL_VERSION "3.0.0")
set(OPENSSL_INCLUDE_DIR "configuration-only/include")
set(OPENSSL_SSL_LIBRARY "configuration-only/ssl.lib")
set(OPENSSL_CRYPTO_LIBRARY "configuration-only/crypto.lib")
include("@_source@/cmake/GenerateCryptoManifest.cmake")
if(NOT ODBCPP_CRYPTO_INSPECTOR OR NOT EXISTS "${ODBCPP_CRYPTO_INSPECTOR}")
  message(FATAL_ERROR "Minimal Windows product metadata omitted the PE inspector")
endif()
]=])
string(CONFIGURE "${_project}" _project @ONLY)
file(WRITE "${_root}/source/CMakeLists.txt" "${_project}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_root}/source" -B "${_root}/build"
  -G "${GENERATOR}" RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr
  TIMEOUT 30)
file(WRITE "${_root}/configure.log" "${_stdout}\n${_stderr}")
if(NOT _result STREQUAL "0")
  message(FATAL_ERROR "Minimal BUILD_TESTING=OFF inspector configure failed:\n${_stdout}\n${_stderr}")
endif()
