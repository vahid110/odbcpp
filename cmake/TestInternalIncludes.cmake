# An incremental build must recheck original source-directory quoted includes.
set(_incremental "${FIXTURE_DIR}/incremental")
file(MAKE_DIRECTORY "${_incremental}/cmake/internal-headers" "${_incremental}/core/database")
file(WRITE "${_incremental}/cmake/internal-headers/composition.txt" "core/database/allowed.h\n")
file(WRITE "${_incremental}/core/database/allowed.h" "#pragma once\n")
file(WRITE "${_incremental}/core/database/private.h" "#pragma once\n")
file(WRITE "${_incremental}/core/database/source.cpp" "#include \"allowed.h\"\n")
file(WRITE "${_incremental}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.20)\nproject(IncrementalClosure NONE)\ninclude(\"${SOURCE_DIR}/cmake/InternalIncludes.cmake\")\nset(ODBCPP_PARTITION_composition \"${_incremental}/core/database/source.cpp\")\nodbcpp_stage_internal_includes(composition)\nadd_custom_target(check ALL)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_incremental}" -B "${_incremental}/build"
  RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Incremental fixture configure failed: ${_out}${_err}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${_incremental}/build"
  RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Allowed incremental fixture failed: ${_out}${_err}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
file(APPEND "${_incremental}/core/database/source.cpp" "#include \"private.h\"\n")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${_incremental}/build"
  RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
if(_result EQUAL 0 OR NOT "${_out}${_err}" MATCHES "Forbidden internal include")
  message(FATAL_ERROR "Incremental source edit bypassed closure check: ${_out}${_err}")
endif()

