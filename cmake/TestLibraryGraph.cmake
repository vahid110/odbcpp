# Script-mode checks that the library graph rules accept allowed links and
# reject every kind of violation (ADR 0002).
include("${CMAKE_CURRENT_LIST_DIR}/LibraryGraph.cmake")

function(expect actual expected label)
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "${label}: expected '${expected}', got '${actual}'")
  endif()
endfunction()

set(_graph "odbcpp_base=" "odbcpp_tls=odbcpp_base" "odbcpp_odbc=odbcpp_base,odbcpp_tls")

odbcpp_library_graph_problem("${ODBCPP_LIBRARY_GRAPH}" _problem)
expect("${_problem}" "" "checked-in graph")
odbcpp_library_graph_problem("${_graph}" _problem)
expect("${_problem}" "" "valid graph")
odbcpp_library_graph_problem("odbcpp_base=;odbcpp_base=" _problem)
expect("${_problem}" "Duplicate library graph entry: odbcpp_base" "duplicate entry")
odbcpp_library_graph_problem("odbcpp_base:odbcpp_tls" _problem)
expect("${_problem}" "Malformed library graph entry: odbcpp_base:odbcpp_tls" "malformed entry")

odbcpp_library_link_problem("${_graph}" odbcpp_odbc "odbcpp_base;$<LINK_ONLY:odbcpp_tls>;Threads::Threads" _problem)
expect("${_problem}" "" "allowed links and non-product links")
odbcpp_library_link_problem("${_graph}" odbcpp_base "odbcpp_tls" _problem)
expect("${_problem}" "Library odbcpp_base may not depend on odbcpp_tls" "disallowed edge")
odbcpp_library_link_problem("${_graph}" odbcpp_tls "$<LINK_ONLY:odbcpp_odbc>" _problem)
expect("${_problem}" "Library odbcpp_tls may not depend on odbcpp_odbc" "wrapped disallowed edge")
odbcpp_library_link_problem("${_graph}" odbcpp_base "$<$<CONFIG:Debug>:odbcpp_tls>" _problem)
expect("${_problem}" "Library odbcpp_base may not depend on odbcpp_tls" "nested generator expression")
odbcpp_library_link_problem("${_graph}" odbcpp_base "odbcpp::core" _problem)
expect("${_problem}" "Library odbcpp_base may not depend on odbcpp::core" "namespaced target")
odbcpp_library_link_problem("${_graph}" odbcpp_unknown "" _problem)
expect("${_problem}" "Library odbcpp_unknown is not in the library graph" "unknown library")
# The check itself, in scratch projects: base may not depend on tls by any route.
if(NOT SCRATCH_DIR)
  set(SCRATCH_DIR "${CMAKE_CURRENT_BINARY_DIR}/library-graph-scratch")
endif()
function(check_project name language libraries body expected)
  set(_dir "${SCRATCH_DIR}/${name}")
  file(REMOVE_RECURSE "${_dir}")
  file(MAKE_DIRECTORY "${_dir}")
  file(WRITE "${_dir}/a.cpp" "int odbcpp_scratch_${name}() { return 0; }\n")
  set(_add "")
  foreach(_library IN ITEMS odbcpp_base odbcpp_tls)
    if(language STREQUAL "NONE")
      string(APPEND _add "add_library(${_library} INTERFACE)\n")
    else()
      string(APPEND _add "add_library(${_library} STATIC a.cpp)\n")
    endif()
  endforeach()
  file(WRITE "${_dir}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.20)
project(GraphScratch ${language})
include(\"${CMAKE_CURRENT_LIST_DIR}/LibraryGraph.cmake\")
set(ODBCPP_LIBRARY_GRAPH \"odbcpp_base=\" \"odbcpp_tls=odbcpp_base\")
${_add}set_property(GLOBAL PROPERTY ODBCPP_LIBRARIES ${libraries})
cmake_language(DEFER DIRECTORY \"\${CMAKE_SOURCE_DIR}\" CALL odbcpp_check_library_graph)
${body}
")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_dir}" -B "${_dir}/build"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(expected STREQUAL "PASS")
    if(NOT _result EQUAL 0 OR NOT EXISTS "${_dir}/build/library-graph-checked.txt")
      message(FATAL_ERROR "${name}: expected a passing, recorded check: ${_out}${_err}")
    endif()
  elseif(_result EQUAL 0 OR NOT "${_out}${_err}" MATCHES "${expected}")
    message(FATAL_ERROR "${name}: expected '${expected}': ${_out}${_err}")
  endif()
endfunction()

set(_both "odbcpp_base odbcpp_tls")
set(_denied "Library odbcpp_base may not depend on odbcpp_tls")
# The product's own link shape: static libraries with PRIVATE links.
check_project(allowed CXX "${_both}" "target_link_libraries(odbcpp_tls PRIVATE odbcpp_base)" PASS)
check_project(private_link CXX "${_both}" "target_link_libraries(odbcpp_base PRIVATE odbcpp_tls)" "${_denied}")
check_project(private_objects CXX "${_both}" "target_sources(odbcpp_base PRIVATE \$<TARGET_OBJECTS:odbcpp_tls>)" "${_denied}")
# Every other route, on interface libraries (no compiler needed).
check_project(interface_link NONE "${_both}" "target_link_libraries(odbcpp_base INTERFACE odbcpp_tls)" "${_denied}")
check_project(alias NONE "${_both}" "add_library(rt ALIAS odbcpp_tls)
target_link_libraries(odbcpp_base INTERFACE rt)" "${_denied}")
check_project(wrapper NONE "${_both}" "add_library(shim INTERFACE)
add_library(shim2 INTERFACE)
target_link_libraries(shim2 INTERFACE odbcpp_tls)
target_link_libraries(shim INTERFACE shim2)
target_link_libraries(odbcpp_base INTERFACE shim)" "${_denied}")
check_project(objects NONE "${_both}" "target_sources(odbcpp_base INTERFACE \$<TARGET_OBJECTS:odbcpp_tls>)" "${_denied}")
check_project(link_options NONE "${_both}" "target_link_options(odbcpp_base INTERFACE \$<TARGET_FILE:odbcpp_tls>)" "${_denied}")
check_project(dependency NONE "${_both}" "add_dependencies(odbcpp_base odbcpp_tls)" "${_denied}")
check_project(core NONE "${_both}" "add_library(odbcpp_core INTERFACE)
target_link_libraries(odbcpp_base INTERFACE odbcpp_core)" "Library odbcpp_base may not depend on odbcpp_core")
check_project(path_is_not_a_target NONE "${_both}" "target_link_libraries(odbcpp_base INTERFACE /opt/odbcpp_tls/libfoo.a)" PASS)
check_project(unregistered NONE "odbcpp_base" "" "Library graph entry without a library: odbcpp_tls")

# The product configuration must have run the check over its libraries.
if(BINARY_DIR)
  set(_record "${BINARY_DIR}/library-graph-checked.txt")
  if(NOT EXISTS "${_record}")
    message(FATAL_ERROR "The product configuration did not run the library graph check")
  endif()
  file(READ "${_record}" _checked)
  foreach(_library IN ITEMS odbcpp_base odbcpp_logging)
    if(NOT _checked MATCHES "(^|\n)${_library}:")
      message(FATAL_ERROR "The library graph check did not cover ${_library}: ${_checked}")
    endif()
  endforeach()
endif()
message(STATUS "library graph checks passed")
