cmake_minimum_required(VERSION 3.20)
# Restaging keeps unchanged copies (and their timestamps), refreshes changed
# ones, and leaves exactly the selected entries: no stale file, link or directory.
if(NOT DEFINED SOURCE_DIR OR NOT DEFINED FIXTURE_DIR)
  message(FATAL_ERROR "SOURCE_DIR and FIXTURE_DIR are required")
endif()
include("${SOURCE_DIR}/cmake/StageHeaders.cmake")
file(REMOVE_RECURSE "${FIXTURE_DIR}")
set(_src "${FIXTURE_DIR}/src")
set(_stage "${FIXTURE_DIR}/stage")
file(WRITE "${_src}/a.h" "#pragma once\nint a;\n")
file(WRITE "${_src}/b.h" "#pragma once\nint b;\n")
file(WRITE "${_src}/c.h" "#pragma once\nint c;\n")

function(expect_tree)
  file(GLOB_RECURSE _actual LIST_DIRECTORIES true RELATIVE "${_stage}" "${_stage}/*")
  list(SORT _actual)
  set(_expected ${ARGN})
  list(SORT _expected)
  if(NOT "${_actual}" STREQUAL "${_expected}")
    message(FATAL_ERROR "Staged tree mismatch: expected '${_expected}', found '${_actual}'")
  endif()
endfunction()
function(stamp logical output)
  file(TIMESTAMP "${_stage}/${logical}" _stamp "%Y-%m-%dT%H:%M:%S" UTC)
  set(${output} "${_stamp}" PARENT_SCOPE)
endfunction()

odbcpp_stage_headers("${_stage}" one/a.h "${_src}/a.h" one/two/b.h "${_src}/b.h" c.h "${_src}/c.h")
expect_tree(c.h one one/a.h one/two one/two/b.h)
stamp(one/a.h _a1)
stamp(one/two/b.h _b1)

# Timestamps have one-second resolution here; wait past it before restaging.
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
file(WRITE "${_src}/c.h" "#pragma once\nint c2;\n")
odbcpp_stage_headers("${_stage}" one/a.h "${_src}/a.h" one/two/b.h "${_src}/b.h" c.h "${_src}/c.h")
stamp(one/a.h _a2)
stamp(one/two/b.h _b2)
if(NOT _a1 STREQUAL _a2 OR NOT _b1 STREQUAL _b2)
  message(FATAL_ERROR "Unchanged staged headers were rewritten: ${_a1}/${_a2} ${_b1}/${_b2}")
endif()
file(READ "${_stage}/c.h" _c)
if(NOT _c MATCHES "int c2;")
  message(FATAL_ERROR "Changed header was not refreshed: ${_c}")
endif()

# Entries dropped from the selection and unselected strays are removed, with
# directories that no longer hold a selected header.
file(WRITE "${_stage}/stray.h" "#pragma once\n")
file(WRITE "${_stage}/old/deep/stray.h" "#pragma once\n")
odbcpp_stage_headers("${_stage}" one/a.h "${_src}/a.h" c.h "${_src}/c.h")
expect_tree(c.h one one/a.h)
stamp(one/a.h _a3)
if(NOT _a1 STREQUAL _a3)
  message(FATAL_ERROR "Pruning rewrote a retained header: ${_a1}/${_a3}")
endif()

# A link at a selected name is replaced by a regular copy, never written through.
file(WRITE "${FIXTURE_DIR}/outside.h" "outside\n")
file(REMOVE "${_stage}/c.h")
file(CREATE_LINK "${FIXTURE_DIR}/outside.h" "${_stage}/c.h" SYMBOLIC RESULT _link_result)
if(_link_result STREQUAL "0")
  odbcpp_stage_headers("${_stage}" one/a.h "${_src}/a.h" c.h "${_src}/c.h")
  file(READ "${FIXTURE_DIR}/outside.h" _outside)
  if(IS_SYMLINK "${_stage}/c.h" OR NOT _outside STREQUAL "outside\n")
    message(FATAL_ERROR "Staging reused or wrote through a link")
  endif()
  expect_tree(c.h one one/a.h)
else()
  message(STATUS "Symlink fixture unavailable on this host: ${_link_result}")
endif()

# Malformed selections are refused before anything is written.
foreach(_case odd escape absolute)
  if(_case STREQUAL "odd")
    set(_args "one/a.h")
    set(_expected "pairs")
  elseif(_case STREQUAL "escape")
    set(_args "../a.h;${_src}/a.h")
    set(_expected "relative logical path")
  else()
    set(_args "${_src}/a.h;${_src}/a.h")
    set(_expected "relative logical path")
  endif()
  set(_script "${FIXTURE_DIR}/refuse-${_case}.cmake")
  file(WRITE "${_script}" "cmake_minimum_required(VERSION 3.20)\ninclude(\"${SOURCE_DIR}/cmake/StageHeaders.cmake\")\nodbcpp_stage_headers(\"${FIXTURE_DIR}/refused\" \"${_args}\")\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -P "${_script}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(_result EQUAL 0 OR NOT "${_out}${_err}" MATCHES "${_expected}" OR EXISTS "${FIXTURE_DIR}/refused")
    message(FATAL_ERROR "Malformed ${_case} selection was not refused precisely: ${_out}${_err}")
  endif()
endforeach()

# Generated inputs keep their timestamp when the content is unchanged.
set(_unit "${FIXTURE_DIR}/unit.cpp")
# Neither @VAR@ nor ${VAR} text in generated content may be expanded.
set(_unit_content [=[#include <one/a.h>
// @literal@ ${not_expanded}
]=])
odbcpp_write_if_changed("${_unit}" "${_unit_content}")
file(TIMESTAMP "${_unit}" _u1 "%Y-%m-%dT%H:%M:%S" UTC)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
odbcpp_write_if_changed("${_unit}" "${_unit_content}")
file(TIMESTAMP "${_unit}" _u2 "%Y-%m-%dT%H:%M:%S" UTC)
file(READ "${_unit}" _unit_text)
if(NOT _u1 STREQUAL _u2)
  message(FATAL_ERROR "Unchanged generated input was rewritten: ${_u1}/${_u2}")
endif()
if(NOT _unit_text STREQUAL _unit_content)
  message(FATAL_ERROR "Generated input content was altered: ${_unit_text}")
endif()
message(STATUS "Stable header staging checks passed")
