# Exact upstream backports; see spdlog-1.17.0-fmt-security.md.
# Validate on EVERY configure, including already-populated source overrides.
function(odbcpp_patch_spdlog_fmt source_dir)
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/spdlog-1.17.0-fmt-security.json" manifest)
  string(JSON count LENGTH "${manifest}" files)
  math(EXPR last "${count} - 1")
  set(base_count 0)
  set(result_count 0)
  foreach(index RANGE ${last})
    string(JSON path GET "${manifest}" files ${index} path)
    string(JSON base GET "${manifest}" files ${index} base_sha256)
    string(JSON result GET "${manifest}" files ${index} result_sha256)
    if(NOT EXISTS "${source_dir}/${path}" OR IS_SYMLINK "${source_dir}/${path}")
      message(FATAL_ERROR "spdlog fmt security: missing or symlink header ${path}")
    endif()
    # A stale file/link at the fixed staging name must never be truncated.
    # Preflight ALL destinations before writing any header or staging file.
    if(EXISTS "${source_dir}/${path}.odbcpp-security-tmp" OR
       IS_SYMLINK "${source_dir}/${path}.odbcpp-security-tmp")
      message(FATAL_ERROR "spdlog fmt security: pre-existing temporary path for ${path}")
    endif()
    file(SHA256 "${source_dir}/${path}" actual)
    if(actual STREQUAL base)
      math(EXPR base_count "${base_count} + 1")
    elseif(actual STREQUAL result)
      math(EXPR result_count "${result_count} + 1")
    else()
      message(FATAL_ERROR "spdlog fmt security: unknown header hash for ${path}: ${actual}")
    endif()
  endforeach()
  if(result_count EQUAL count)
    return()
  endif()
  if(NOT base_count EQUAL count)
    message(FATAL_ERROR "spdlog fmt security: partial/mixed patch state; repopulate the pinned archive")
  endif()

  # Compute and hash ALL outputs before mutating any header. Unknown inputs or
  # damaged control hunks cannot leave a partially patched source directory.
  foreach(index RANGE ${last})
    string(JSON path GET "${manifest}" files ${index} path)
    string(JSON result GET "${manifest}" files ${index} result_sha256)
    file(READ "${source_dir}/${path}" content)
    string(JSON hunk_count LENGTH "${manifest}" files ${index} hunks)
    math(EXPR hunk_last "${hunk_count} - 1")
    foreach(hunk RANGE ${hunk_last})
      string(JSON before GET "${manifest}" files ${index} hunks ${hunk} before)
      string(JSON after GET "${manifest}" files ${index} hunks ${hunk} after)
      string(REPLACE "${before}" "${after}" content "${content}")
    endforeach()
    string(SHA256 computed "${content}")
    if(NOT computed STREQUAL result)
      message(FATAL_ERROR "spdlog fmt security: result hash mismatch for ${path}")
    endif()
    set(output_${index} "${content}")
  endforeach()
  foreach(index RANGE ${last})
    string(JSON path GET "${manifest}" files ${index} path)
    file(WRITE "${source_dir}/${path}.odbcpp-security-tmp" "${output_${index}}")
    file(RENAME "${source_dir}/${path}.odbcpp-security-tmp" "${source_dir}/${path}")
  endforeach()
  # Read back the final on-disk bytes, not merely the in-memory replacement.
  foreach(index RANGE ${last})
    string(JSON path GET "${manifest}" files ${index} path)
    string(JSON result GET "${manifest}" files ${index} result_sha256)
    file(SHA256 "${source_dir}/${path}" actual)
    if(NOT actual STREQUAL result)
      message(FATAL_ERROR "spdlog fmt security: final readback mismatch for ${path}")
    endif()
  endforeach()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  if(NOT DEFINED SPDLOG_SOURCE_DIR OR SPDLOG_SOURCE_DIR STREQUAL "")
    message(FATAL_ERROR "Pass -DSPDLOG_SOURCE_DIR=<pinned spdlog source>")
  endif()
  odbcpp_patch_spdlog_fmt("${SPDLOG_SOURCE_DIR}")
endif()
