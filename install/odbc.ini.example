# ODBCPP DSN Examples
# Add these sections to your system's odbc.ini or ~/.odbc.ini file

[RedshiftProd]
Driver=ODBCPP Redshift
Server=your-cluster.redshift.amazonaws.com
Port=5439
Database=analytics
UID=your-username
PWD=your-password
SSL=1
TransportMode=Auto
AsyncMaxInflight=64
AsyncQueueDepth=256
AsyncEngine=Auto
DeadlineModel=Strict
Description=Production Redshift cluster

[RedshiftDev]
Driver=ODBCPP Redshift
Server=dev-cluster.redshift.amazonaws.com
Port=5439
Database=dev
UID=dev-user
PWD=dev-password
SSL=1
TransportMode=Sync
DeadlineModel=Strict
Description=Development Redshift cluster

[PostgreSQLLocal]
Driver=ODBCPP PostgreSQL
Server=localhost
Port=5432
Database=postgres
UID=postgres
PWD=postgres
SSL=0
TransportMode=Auto
DeadlineModel=SocketTimeout
Description=Local PostgreSQL database
