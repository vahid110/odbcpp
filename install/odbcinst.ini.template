# ODBCPP Driver Registration Template
# Add this section to your system's odbcinst.ini file

[ODBCPP Redshift]
Description=ODBCPP Driver for Amazon Redshift
Driver=@DRIVER_PATH@/libodbcpp.so
Setup=@DRIVER_PATH@/libodbcpp.so
FileUsage=1
CPTimeout=
CPReuse=
DriverUnicodeType=UTF16
LogLevel=Off
LogAsync=true
LogFormat=Text
LogMaxSize=10485760
LogMaxFiles=5
LogQueries=false
TransportMode=Auto
AsyncMaxInflight=64
AsyncQueueDepth=256
AsyncEngine=Auto
DeadlineModel=Strict

[ODBCPP PostgreSQL]
Description=ODBCPP Driver for PostgreSQL
Driver=@DRIVER_PATH@/libodbcpp.so
Setup=@DRIVER_PATH@/libodbcpp.so
FileUsage=1
CPTimeout=
CPReuse=
DriverUnicodeType=UTF16
LogLevel=Off
LogAsync=true
LogFormat=Text
LogMaxSize=10485760
LogMaxFiles=5
LogQueries=false
TransportMode=Auto
AsyncMaxInflight=64
AsyncQueueDepth=256
AsyncEngine=Auto
DeadlineModel=Strict
