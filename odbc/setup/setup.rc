#include <windows.h>
#include "resource.h"
IDD_SETUP DIALOGEX 0, 0, 304, 224
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ODBCPP PostgreSQL Setup"
FONT 9, "Segoe UI"
BEGIN
 CONTROL "", IDC_TABS, "SysTabControl32", WS_TABSTOP, 8, 8, 288, 164
 LTEXT "Data source name", IDC_DSN_LABEL, 18, 39, 82, 12
 EDITTEXT IDC_DSN, 104, 37, 180, 14, ES_AUTOHSCROLL
 LTEXT "Server", IDC_SERVER_LABEL, 18, 65, 82, 12
 EDITTEXT IDC_SERVER, 104, 63, 180, 14, ES_AUTOHSCROLL
 LTEXT "Port", IDC_PORT_LABEL, 18, 91, 82, 12
 EDITTEXT IDC_PORT, 104, 89, 65, 14, ES_AUTOHSCROLL | ES_NUMBER
 LTEXT "Database", IDC_DATABASE_LABEL, 18, 117, 82, 12
 EDITTEXT IDC_DATABASE, 104, 115, 180, 14, ES_AUTOHSCROLL
 AUTOCHECKBOX "Use TLS", IDC_SSL, 104, 141, 80, 12
 LTEXT "Authentication: database password", IDC_AUTH_LABEL, 18, 39, 260, 12
 LTEXT "User", IDC_USER_LABEL, 18, 65, 82, 12
 EDITTEXT IDC_USER, 104, 63, 180, 14, ES_AUTOHSCROLL
 LTEXT "Test password", IDC_PASSWORD_LABEL, 18, 91, 82, 12
 EDITTEXT IDC_PASSWORD, 104, 89, 180, 14, ES_AUTOHSCROLL | ES_PASSWORD
 LTEXT "Passwords are never saved. Supply credentials in your application.", IDC_PASSWORD_NOTE, 18, 119, 260, 28
 LTEXT "", IDC_STATUS, 10, 177, 282, 20
 PUSHBUTTON "Test connection", IDC_TEST, 10, 202, 84, 14
 DEFPUSHBUTTON "Save", IDOK, 178, 202, 50, 14
 PUSHBUTTON "Cancel", IDCANCEL, 236, 202, 50, 14
END
