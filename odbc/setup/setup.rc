#include <windows.h>
#include <commctrl.h>
#include "resource.h"
2 RT_MANIFEST "setup.manifest"

IDD_SETUP DIALOGEX 0, 0, 438, 355
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ODBCPP Data Source Setup"
FONT 10, "Segoe UI"
BEGIN
 LTEXT "ODBCPP", IDC_HEADING, 18, 12, 396, 23
 LTEXT "Connection settings for your applications", IDC_SUBTITLE, 18, 39, 396, 13
 LTEXT "", IDC_SCOPE, 18, 57, 396, 13
 CONTROL "", IDC_TABS, "SysTabControl32", TCS_BUTTONS | TCS_FLATBUTTONS | TCS_FIXEDWIDTH | WS_TABSTOP, 16, 79, 406, 25

 LTEXT "Data source name", IDC_DSN_LABEL, 30, 111, 330, 12
 EDITTEXT IDC_DSN, 30, 126, 376, 17, ES_AUTOHSCROLL
 LTEXT "Server", IDC_SERVER_LABEL, 30, 154, 270, 12
 EDITTEXT IDC_SERVER, 30, 169, 286, 17, ES_AUTOHSCROLL
 LTEXT "Port", IDC_PORT_LABEL, 330, 154, 76, 12
 EDITTEXT IDC_PORT, 330, 169, 76, 17, ES_AUTOHSCROLL | ES_NUMBER
 LTEXT "Database", IDC_DATABASE_LABEL, 30, 197, 376, 12
 EDITTEXT IDC_DATABASE, 30, 212, 376, 17, ES_AUTOHSCROLL
 LTEXT "Application name", IDC_APP_LABEL, 30, 240, 150, 12
 AUTOCHECKBOX "Use driver default", IDC_APP_DEFAULT, 282, 238, 124, 15
 EDITTEXT IDC_APP, 30, 255, 376, 17, ES_AUTOHSCROLL
 LTEXT "Applications can override these settings in their connection string.", IDC_CONNECTION_NOTE, 30, 280, 376, 12

 LTEXT "Database password", IDC_AUTH_LABEL, 30, 111, 376, 13
 LTEXT "User name", IDC_USER_LABEL, 30, 137, 180, 12
 EDITTEXT IDC_USER, 30, 152, 180, 17, ES_AUTOHSCROLL
 LTEXT "Password for testing only", IDC_PASSWORD_LABEL, 224, 137, 182, 12
 EDITTEXT IDC_PASSWORD, 224, 152, 182, 17, ES_AUTOHSCROLL | ES_PASSWORD
 LTEXT "Passwords are never saved. Your application supplies its credentials.", IDC_PASSWORD_NOTE, 30, 177, 376, 13
 AUTOCHECKBOX "Use TLS to protect this connection", IDC_SSL, 30, 201, 376, 15
 LTEXT "Trust source", IDC_TRUST_LABEL, 30, 229, 90, 12
 COMBOBOX IDC_TRUST, 126, 226, 280, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 EDITTEXT IDC_CA_PATH, 30, 253, 300, 17, ES_AUTOHSCROLL
 PUSHBUTTON "Browse...", IDC_CA_BROWSE, 340, 253, 66, 17
 LTEXT "TLS uses certificate and hostname verification. Custom trust is optional.", IDC_TLS_NOTE, 30, 279, 376, 13

 LTEXT "Select a setting to review or override its value.", IDC_PROPERTIES_LABEL, 30, 111, 376, 13
 CONTROL "", IDC_PROPERTIES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 30, 133, 376, 93
 AUTOCHECKBOX "Set a value for this data source", IDC_PROPERTY_OVERRIDE, 30, 237, 376, 15
 COMBOBOX IDC_PROPERTY_VALUE, 30, 257, 376, 90, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP | CBS_AUTOHSCROLL
 LTEXT "", IDC_PROPERTY_DESCRIPTION, 30, 280, 376, 13

 LTEXT "Connection test details", IDC_DETAILS_LABEL, 30, 111, 376, 13
 EDITTEXT IDC_DETAILS, 30, 133, 376, 116, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
 LTEXT "Tests request a five-second login timeout; DNS resolution can take longer.\nClosing during a test waits for completion. Testing does not save settings.", IDC_TEST_NOTE, 30, 261, 376, 29

 LTEXT "Ready to configure", IDC_STATUS, 18, 307, 402, 15
 PUSHBUTTON "Test connection", IDC_TEST, 18, 329, 94, 19
 DEFPUSHBUTTON "Save", IDOK, 277, 329, 67, 19
 PUSHBUTTON "Cancel", IDCANCEL, 354, 329, 67, 19
END
